\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{yugenillumination}[2026/05/15 Optical Foundry illuminated initial helpers]

\RequirePackage{graphicx}
\RequirePackage{wrapfig}

\newlength{\OFInitialWidth}
\newlength{\OFInitialGap}
\newcommand{\OFInitialAlignTop}{top}
\newcommand{\OFInitialAlignBottom}{bottom}

% Args:
% 1 image path
% 2 image width, e.g. .84in
% 3 wrapped line count, e.g. 4
% 4 gap between image block and text, e.g. .08in
% 5 vertical nudge/baseline correction, e.g. 0in or -.08in
% 6 alignment mode: bottom | top (retained for source/evidence compatibility)
\newcommand{\OFImageInitialSetup}[6]{%
  \par\noindent%
  \setlength{\OFInitialWidth}{#2}%
  \setlength{\OFInitialGap}{#4}%
  \begin{wrapfigure}[#3]{l}{\dimexpr\OFInitialWidth+\OFInitialGap\relax}%
    \vspace*{\dimexpr#5-.85\baselineskip\relax}%
    \includegraphics[width=\OFInitialWidth]{#1}%
  \end{wrapfigure}%
  \ignorespaces%
}
